@model HMS.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>

<h3>Are you sure you want to delete this appointment?</h3>

<div>
    <h4>Appointment</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.PatientId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.PatientId)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.DoctorId)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.DoctorId)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AppointmentDate)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AppointmentDate)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.AppointmentTime)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.AppointmentTime)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Reason)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Reason)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="AppointmentId" />

        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>