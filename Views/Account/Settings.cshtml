@{
    ViewData["Title"] = "Settings";
}

<div class="hms-page">
    <div class="container">

        <!-- Header -->
        <div class="hms-page-header mb-4">

            <div>
                <span class="text-uppercase text-muted small fw-semibold">
                    Account
                </span>

                <h1 class="hms-title mt-1">
                    Settings
                </h1>

                <p class="hms-subtitle">
                    Manage your account preferences and security.
                </p>
            </div>

            <div>
                <a asp-controller="Account"
                   asp-action="Profile"
                   class="btn btn-outline-secondary">
                    ← Back to Profile
                </a>
            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success hms-alert">
                @TempData["SuccessMessage"]
            </div>
        }


        <div class="row g-4">

            <!-- Appearance -->
            <div class="col-lg-4">

                <div class="hms-card h-100">

                    <div class="hms-card-header">

                        <div>
                            <h5 class="mb-1">
                                Appearance
                            </h5>

                            <p class="text-muted mb-0">
                                Choose how HMS looks on your device.
                            </p>
                        </div>

                    </div>

                    <div class="p-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <strong>Dark Mode</strong>

                                <div class="small text-muted mt-1">
                                    Switch between light and dark theme.
                                </div>
                            </div>

                            <div class="form-check form-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="darkModeToggle">

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Security -->
            <div class="col-lg-4">

                <div class="hms-card h-100">

                    <div class="hms-card-header">

                        <div>
                            <h5 class="mb-1">
                                Security
                            </h5>

                            <p class="text-muted mb-0">
                                Manage your account password.
                            </p>
                        </div>

                    </div>

                    <div class="p-4">

                        <p class="text-muted">
                            Change your account password whenever necessary.
                        </p>

                        <a asp-controller="Account"
                           asp-action="ChangePassword"
                           class="btn hms-btn hms-btn-primary w-100">
                            Change Password
                        </a>

                    </div>

                </div>

            </div>


            <!-- Privacy -->
            <div class="col-lg-4">

                <div class="hms-card h-100">

                    <div class="hms-card-header">

                        <div>
                            <h5 class="mb-1">
                                Privacy & Policy
                            </h5>

                            <p class="text-muted mb-0">
                                Review HMS privacy information.
                            </p>
                        </div>

                    </div>

                    <div class="p-4">

                        <p class="text-muted">
                            Read information about privacy, data protection
                            and system usage.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="btn btn-outline-secondary w-100">
                            Privacy & Policy
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>


@section Scripts {

    <script>

        const darkModeToggle =
            document.getElementById("darkModeToggle");

        // Load saved theme
        const savedTheme =
            localStorage.getItem("hms-theme");

        if (savedTheme === "dark") {

            document.body.classList.add("hms-dark-mode");

            darkModeToggle.checked = true;
        }


        // Toggle theme
        darkModeToggle.addEventListener("change", function() {

            if (this.checked) {

                document.body.classList.add("hms-dark-mode");

                localStorage.setItem("hms-theme", "dark");

            }
            else {

                document.body.classList.remove("hms-dark-mode");

                localStorage.setItem("hms-theme", "light");

            }

        });

    </script>

}