@model IEnumerable<HospitalManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="hms-page">
    <div class="container">

        <div class="hms-page-header">

            <div>
                <h1 class="hms-title">
                    My Appointments
                </h1>

                <p class="hms-subtitle">
                    View your scheduled and previous appointments.
                </p>
            </div>

            <a asp-controller="PatientPortal"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">
                Back to Dashboard
            </a>

        </div>


        <div class="hms-card">

            <div class="hms-card-header">

                <h4 class="mb-0">
                    Appointment History
                </h4>

            </div>


            <div class="table-responsive">

                <table class="table hms-table">

                    <thead>

                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Doctor</th>
                            <th>Status</th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center py-5 text-muted">

                                    No appointments found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var appointment in Model)
                            {
                                <tr>

                                    <td>
                                        @appointment.AppointmentDate
                                        .ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @appointment.AppointmentTime
                                    </td>

                                    <td>
                                        <strong>
                                            @(appointment.Doctor?.FullName
                                                ?? "Not Assigned")
                                        </strong>
                                    </td>

                                    <td>

                                        @if (appointment.Status == "Scheduled")
                                        {
                                            <span class="badge bg-primary">
                                                Scheduled
                                            </span>
                                        }
                                        else if (appointment.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (appointment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-secondary">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">
                                                @appointment.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>