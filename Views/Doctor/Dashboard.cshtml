@model IEnumerable<HospitalManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="hms-page">
    <div class="container">

        <!-- Dashboard Header -->
        <div class="hms-page-header">
            <div>
                <h1 class="hms-title">
                    Doctor Dashboard
                </h1>

                <p class="hms-subtitle">
                    Welcome back,
                    <strong>@ViewBag.DoctorName</strong>.
                    Manage your clinical appointments and patient care.
                </p>
            </div>
        </div>

        <!-- Error Message -->
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger hms-alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <!-- Statistics -->
        <div class="row g-4 mb-4">

            <!-- Total Appointments -->
            <div class="col-md-4">
                <div class="hms-card h-100">
                    <div class="p-4">

                        <div class="text-muted small">
                            TOTAL APPOINTMENTS
                        </div>

                        <h2 class="mt-2 mb-0">
                            @ViewBag.TotalAppointments
                        </h2>

                        <p class="text-muted mb-0 mt-2">
                            All assigned appointments
                        </p>

                    </div>
                </div>
            </div>

            <!-- Today's Appointments -->
            <div class="col-md-4">
                <div class="hms-card h-100">
                    <div class="p-4">

                        <div class="text-muted small">
                            TODAY
                        </div>

                        <h2 class="mt-2 mb-0">
                            @ViewBag.TodayAppointments
                        </h2>

                        <p class="text-muted mb-0 mt-2">
                            Appointments scheduled today
                        </p>

                    </div>
                </div>
            </div>

            <!-- Upcoming Appointments -->
            <div class="col-md-4">
                <div class="hms-card h-100">
                    <div class="p-4">

                        <div class="text-muted small">
                            UPCOMING
                        </div>

                        <h2 class="mt-2 mb-0">
                            @ViewBag.UpcomingAppointments
                        </h2>

                        <p class="text-muted mb-0 mt-2">
                            Scheduled appointments
                        </p>

                    </div>
                </div>
            </div>

        </div>

        <!-- My Appointments -->
        <div class="hms-card">

            <div class="hms-card-header">
                <div>
                    <h3 class="mb-1">
                        My Appointments
                    </h3>

                    <p class="text-muted mb-0">
                        Appointments assigned to you.
                    </p>
                </div>
            </div>

            <div class="table-responsive">

                <table class="table hms-table align-middle">

                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-5 text-muted">

                                    No appointments assigned yet.

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var appointment in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @(appointment.Patient?.FullName ?? "Unknown Patient")
                                        </strong>
                                    </td>

                                    <td>
                                        @appointment.AppointmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @appointment.AppointmentTime
                                    </td>

                                    <td>
                                        @(appointment.Reason ?? "—")
                                    </td>

                                    <td>

                                        @if (appointment.Status == "Scheduled")
                                        {
                                            <span class="badge bg-primary">
                                                Scheduled
                                            </span>
                                        }
                                        else if (appointment.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (appointment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @appointment.Status
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Doctor"
                                           asp-action="AppointmentDetails"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>