@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Schedule Appointment";

    var patients = ViewBag.Patients as IEnumerable<HospitalManagementSystem.Models.Patient>;
    var doctors = ViewBag.Doctors as IEnumerable<HospitalManagementSystem.Models.Doctor>;
}

<div class="hms-page">
    <div class="container">

        <div class="hms-page-header mb-4">

            <div>
                <span class="text-uppercase text-muted small fw-semibold">
                    Appointment Management
                </span>

                <h1 class="hms-title mt-1">
                    Schedule Appointment
                </h1>

                <p class="hms-subtitle">
                    Create a new appointment between a patient and doctor.
                </p>
            </div>

            <a asp-action="Index"
               class="btn hms-btn hms-btn-outline">
                ← Back to Appointments
            </a>

        </div>

        <div class="hms-card">

            <div class="hms-card-header">
                <div>
                    <h5 class="mb-1">
                        Appointment Information
                    </h5>

                    <p class="text-muted mb-0">
                        Enter the required appointment details.
                    </p>
                </div>
            </div>

            <div class="p-4">

                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-4">

                        <!-- Patient -->
                        <div class="col-md-6">

                            <label asp-for="PatientId"
                                   class="form-label fw-semibold">
                                Patient
                            </label>

                            <select asp-for="PatientId"
                                    class="form-select">

                                <option value="">
                                    Select Patient
                                </option>

                                @if (patients != null)
                                {
                                    foreach (var patient in patients)
                                    {
                                        <option value="@patient.PatientId">
                                            @patient.FullName
                                        </option>
                                    }
                                }

                            </select>

                            <span asp-validation-for="PatientId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Doctor -->
                        <div class="col-md-6">

                            <label asp-for="DoctorId"
                                   class="form-label fw-semibold">
                                Doctor
                            </label>

                            <select asp-for="DoctorId"
                                    class="form-select">

                                <option value="">
                                    Select Doctor
                                </option>

                                @if (doctors != null)
                                {
                                    foreach (var doctor in doctors)
                                    {
                                        <option value="@doctor.DoctorId">
                                            @doctor.FullName
                                        </option>
                                    }
                                }

                            </select>

                            <span asp-validation-for="DoctorId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Date -->
                        <div class="col-md-6">

                            <label asp-for="AppointmentDate"
                                   class="form-label fw-semibold">
                                Appointment Date
                            </label>

                            <input asp-for="AppointmentDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="AppointmentDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Time -->
                        <div class="col-md-6">

                            <label asp-for="AppointmentTime"
                                   class="form-label fw-semibold">
                                Appointment Time
                            </label>

                            <input asp-for="AppointmentTime"
                                   type="time"
                                   class="form-control" />

                            <span asp-validation-for="AppointmentTime"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Reason -->
                        <div class="col-12">

                            <label asp-for="Reason"
                                   class="form-label fw-semibold">
                                Reason for Visit
                            </label>

                            <textarea asp-for="Reason"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Briefly describe the reason for the appointment...">
                            </textarea>

                            <span asp-validation-for="Reason"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="border-top mt-4 pt-4 d-flex justify-content-end gap-2">

                        <a asp-action="Index"
                           class="btn hms-btn hms-btn-outline">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn hms-btn hms-btn-primary">
                            Schedule Appointment
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}