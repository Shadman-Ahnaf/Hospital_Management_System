@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="hms-page">
    <div class="container">

        <div class="hms-page-header">

            <div>
                <h1 class="hms-title">
                    Appointment Details
                </h1>

                <p class="hms-subtitle">
                    View information about your hospital appointment.
                </p>
            </div>

            <a asp-action="MyAppointments"
               class="btn btn-outline-secondary">
                Back to Appointments
            </a>

        </div>


        <div class="hms-card">

            <div class="hms-card-header">

                <div>
                    <h3 class="mb-1">
                        Appointment Information
                    </h3>

                    <p class="text-muted mb-0">
                        Appointment #@Model.AppointmentId
                    </p>
                </div>

            </div>


            <div class="p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Appointment Date
                        </label>

                        <div class="form-control bg-light">
                            @Model.AppointmentDate.ToString("dd MMM yyyy")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Appointment Time
                        </label>

                        <div class="form-control bg-light">
                            @Model.AppointmentTime
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Doctor
                        </label>

                        <div class="form-control bg-light">
                            @(Model.Doctor?.FullName ?? "Not Assigned")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Department
                        </label>

                        <div class="form-control bg-light">
                            @(Model.Doctor?.Department?.DepartmentName
                                ?? "Not Assigned")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Status
                        </label>

                        <div class="mt-2">

                            @if (Model.Status == "Scheduled")
                            {
                                <span class="badge bg-primary fs-6">
                                    Scheduled
                                </span>
                            }
                            else if (Model.Status == "Completed")
                            {
                                <span class="badge bg-success fs-6">
                                    Completed
                                </span>
                            }
                            else if (Model.Status == "Cancelled")
                            {
                                <span class="badge bg-danger fs-6">
                                    Cancelled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>