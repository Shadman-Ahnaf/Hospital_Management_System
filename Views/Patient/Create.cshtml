@model HospitalManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Register Patient";
}

<div class="hms-page">
    <div class="container">

        <div class="hms-page-header">
            <div>
                <h1 class="hms-title">Register Patient</h1>
                <p class="hms-subtitle">
                    Enter the patient's personal and contact information.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary hms-btn">
                Back to Patients
            </a>
        </div>

        <div class="hms-card">
            <div class="hms-card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="FullName"
                                   class="form-label hms-form-label">
                                Full Name
                            </label>
                            <input asp-for="FullName"
                                   class="form-control hms-form-control"
                                   placeholder="Enter full name" />
                            <span asp-validation-for="FullName"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth"
                                   class="form-label hms-form-label">
                                Date of Birth
                            </label>
                            <input asp-for="DateOfBirth"
                                   class="form-control hms-form-control" />
                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Gender"
                                   class="form-label hms-form-label">
                                Gender
                            </label>
                            <select asp-for="Gender"
                                    class="form-select hms-form-control">
                                <option value="">Select gender</option>
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Gender"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone"
                                   class="form-label hms-form-label">
                                Phone
                            </label>
                            <input asp-for="Phone"
                                   class="form-control hms-form-control"
                                   placeholder="Enter phone number" />
                            <span asp-validation-for="Phone"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email"
                                   class="form-label hms-form-label">
                                Email
                            </label>
                            <input asp-for="Email"
                                   class="form-control hms-form-control"
                                   placeholder="Enter email address" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BloodGroup"
                                   class="form-label hms-form-label">
                                Blood Group
                            </label>
                            <input asp-for="BloodGroup"
                                   class="form-control hms-form-control"
                                   placeholder="e.g. A+" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Address"
                                   class="form-label hms-form-label">
                                Address
                            </label>
                            <textarea asp-for="Address"
                                      class="form-control hms-form-control"
                                      rows="3"
                                      placeholder="Enter address"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="EmergencyContact"
                                   class="form-label hms-form-label">
                                Emergency Contact
                            </label>
                            <input asp-for="EmergencyContact"
                                   class="form-control hms-form-control"
                                   placeholder="Name and contact number" />
                        </div>

                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <button type="submit"
                                class="btn hms-btn hms-btn-primary">
                            Register Patient
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary hms-btn ms-2">
                            Cancel
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}