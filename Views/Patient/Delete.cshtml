@model HospitalManagementSystem.Models.Patient

@{
    ViewData["Title"] = "Remove Patient";
}

<div class="hms-page">
    <div class="container">

        <div class="hms-page-header">
            <div>
                <h1 class="hms-title">Remove Patient</h1>
                <p class="hms-subtitle">
                    Confirm removal of this patient record.
                </p>
            </div>
        </div>

        <div class="hms-card">
            <div class="hms-card-body">

                <div class="alert alert-warning">
                    <strong>Are you sure?</strong>
                    This action will permanently remove the patient record.
                </div>

                <h4 class="mb-4">@Model.FullName</h4>

                <div class="row">
                    <div class="col-md-4">
                        <strong>Phone</strong>
                        <p>@Model.Phone</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Email</strong>
                        <p>@(Model.Email ?? "Not provided")</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Blood Group</strong>
                        <p>@(Model.BloodGroup ?? "Not provided")</p>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">

                    <input type="hidden" asp-for="PatientId" />

                    <button type="submit"
                            class="btn hms-btn hms-btn-danger">
                        Remove Patient
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary hms-btn ms-2">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>
</div>