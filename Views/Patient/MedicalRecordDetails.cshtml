@model HospitalManagementSystem.Models.MedicalRecord

@{
    ViewData["Title"] = "Medical Record Details";
}

<div class="hms-page">
    <div class="container">

        <div class="hms-page-header">

            <div>
                <h1 class="hms-title">
                    Medical Record
                </h1>

                <p class="hms-subtitle">
                    Details of your diagnosis and treatment.
                </p>
            </div>

            <a asp-action="MedicalRecords"
               class="btn btn-outline-secondary">
                Back to Medical Records
            </a>

        </div>


        <div class="hms-card">

            <div class="hms-card-header">

                <h3 class="mb-0">
                    Consultation Record
                </h3>

            </div>


            <div class="p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Record Date
                        </label>

                        <div class="form-control bg-light">
                            @Model.RecordDate.ToString("dd MMM yyyy")
                        </div>

                    </div>


                    <div class="col-md-6">

                        <label class="form-label text-muted">
                            Doctor
                        </label>

                        <div class="form-control bg-light">
                            @(Model.Doctor?.FullName ?? "Not Available")
                        </div>

                    </div>


                    <div class="col-12">

                        <label class="form-label text-muted">
                            Diagnosis
                        </label>

                        <div class="form-control bg-light"
                             style="min-height:100px;">
                            @Model.Diagnosis
                        </div>

                    </div>


                    <div class="col-12">

                        <label class="form-label text-muted">
                            Treatment Details
                        </label>

                        <div class="form-control bg-light"
                             style="min-height:120px;">

                            @(string.IsNullOrWhiteSpace(Model.TreatmentDetails)
                                ? "No treatment details recorded."
                                : Model.TreatmentDetails)

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>